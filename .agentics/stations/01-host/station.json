{
  "id": "host",
  "name": "HØST",
  "trigger": {
    "type": "dispatch_worker",
    "idleTimeoutMinutes": 2,
    "maxTimeoutMinutes": 30,
    "labels": [],
    "recipe": {
      "document": {
        "name": "linkedin-beskeder",
        "description": "Høster dine LinkedIn-samtaler til det personlige kartotek: én række pr. besked, med samtale-id'et indlejret i beskedens URN. Selektorerne er målt mod et levende login 15/11 — kun msg-*-klasser, fordi LinkedIn sender hashede klassenavne ved siden af dem. Samtalerne åbnes med `openEach`, fordi listen ingen ankre har: der er intet `href` at gå til, og samtalens id står i nul attributter på siden.",
        "profile": "linkedin",
        "params": {
          "sidstSete": {
            "description": "Besked-URN'er kartoteket allerede har fået. Trayen fylder den fra linkedin-beskeder.seen.json og filtrerer selv — høsten her er fuld, så en tråd der får et svar bliver set igen."
          }
        },
        "result": [
          "beskeder",
          "hoveder"
        ],
        "steps": [
          {
            "id": "aabn",
            "do": "goto",
            "url": "https://www.linkedin.com/messaging/"
          },
          {
            "id": "vent",
            "do": "assert",
            "selector": "li.msg-conversation-listitem .msg-conversation-listitem__link"
          },
          {
            "id": "samtaler",
            "do": "openEach",
            "target": "linkedin:conversations",
            "as": "traad",
            "maxItems": 25,
            "collect": [
              {
                "id": "hoved",
                "do": "collect",
                "selector": "div.msg-thread",
                "as": "hoveder",
                "fields": {
                  "profil": "a.msg-thread__link-to-profile @href",
                  "visitkort": "a.msg-thread__link-to-profile"
                }
              },
              {
                "id": "beskeder",
                "do": "collect",
                "selector": "li.msg-s-message-list__event",
                "as": "beskeder",
                "fields": {
                  "urn": "[data-event-urn] @data-event-urn",
                  "afsender": ".msg-s-message-group__name",
                  "klokkeslaet": ".msg-s-message-group__timestamp",
                  "dato": ".msg-s-message-list__time-heading",
                  "indgaaende": ".msg-s-event-listitem--other ?",
                  "tekst": ".msg-s-event-listitem__body"
                }
              }
            ]
          }
        ]
      },
      "profile": "linkedin",
      "channel": "msedge",
      "timeoutMs": 900000,
      "publish": {
        "kind": "stakeholders",
        "handoff": {
          "assemblyLineId": "mwhso55p-asmue3",
          "columnId": "research"
        }
      }
    }
  }
}
